rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣거나
//   firebase deploy --only firestore:rules
// 로 배포하세요.
//
// 설계 의도
//  - 카운터는 오직 "증가"만 가능합니다. 클라이언트에서 감소·삭제·초기화가
//    불가능합니다. 정적 페이지라 앱 코드는 누구나 볼 수 있으므로 데이터
//    보호를 규칙 층에서 강제합니다.
//  - 초기화 대신 /stats/에서 새 회차를 시작하세요. 지난 회차는 남습니다.
//  - 게임마다 games/{게임}-r{회차} 아래로 분리되어 통계가 섞이지 않습니다.
//    초기화 대신 회차를 올리므로 지난 기록이 지워지지 않습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    // 게임 설정(목표치 등). 관리자 계정만 쓸 수 있습니다.
    //
    // 관리자 계정 이메일입니다. Firebase 콘솔 > Authentication 에서 이 이메일로
    // 계정을 만들어 두면, 브라우저를 바꿔도 기기를 바꿔도 그대로 쓸 수 있습니다.
    // 이메일이 공개돼도 비밀번호 없이는 로그인할 수 없습니다.
    
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'jyt6640@gmail.com';
    }

    // 자물쇠 정답. 문서 id가 정답의 해시입니다.
    //   - get만 허용하므로 맞는 값을 넣어야 문서가 열립니다.
    //   - list를 막았으므로 목록을 훑어 정답을 알아낼 수 없습니다.
    //   - 정답도 정답의 해시도 클라이언트로 내려가지 않습니다.
    match /lockAnswers/{hash} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null && request.auth.token.email == 'jyt6640@gmail.com';
    }

    // 자물쇠 힌트. 문서 id는 "{회차문서}_{자리}" 형식이며, 그 회차에서
    // 공개 단계에 도달한 자리까지만 읽힙니다.
    match /lockHints/{index} {
      allow get: if request.auth != null
                 && int(index.split('_')[1]) <=
                    get(/databases/$(database)/documents/games/$(index.split('_')[0]))
                      .data.hintLevel;
      allow list: if false;
      allow write: if request.auth != null && request.auth.token.email == 'jyt6640@gmail.com';
    }

    // 게임이 끝난 뒤에만 읽히는 문구. 문서 id는 회차 문서 id와 같습니다.
    match /payloads/{roundId} {
      allow get: if request.auth != null
                 && get(/databases/$(database)/documents/games/$(roundId))
                      .data.status == 'completed';
      allow list: if false;
      allow write: if request.auth != null && request.auth.token.email == 'jyt6640@gmail.com';
    }

    match /games/{roundId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.status == 'active';
      // 시작 시각과 목표치는 이후 변경할 수 없습니다.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'endTime', 'milestones',
                                   'lastPress', 'lastPresser', 'winner',
                                   'hintLevel']);
      allow delete: if false;

      // 카운터 샤드 — 동시 쓰기 분산용
      match /shards/{shard} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['c'])
                      && request.resource.data.c is int
                      && request.resource.data.c > 0
                      && request.resource.data.c <= 5000;
        allow update: if request.auth != null
                      && request.resource.data.keys().hasOnly(['c'])
                      && request.resource.data.c is int
                      && request.resource.data.c > resource.data.c
                      && request.resource.data.c - resource.data.c <= 5000;
        allow delete: if false;
      }

      // 익명 참여자별 기록 — 본인 문서만 쓸 수 있습니다.
      match /users/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.count >= resource.data.count;
        allow delete: if false;
      }
    }
  }
}
