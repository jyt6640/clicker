rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣거나
//   firebase deploy --only firestore:rules
// 로 배포하세요.
//
// 설계 의도
//  - 카운터는 오직 "증가"만 가능합니다. 클라이언트에서 감소·삭제·초기화가
//    불가능합니다. 정적 페이지라 앱 코드는 누구나 볼 수 있으므로 데이터
//    보호를 규칙 층에서 강제합니다.
//  - 초기화가 필요하면 Firebase 콘솔에서 직접 문서를 삭제하세요.
//  - 게임마다 games/{gameId} 아래로 완전히 분리되어 통계가 섞이지 않습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    // 게임 설정(목표치·정답 해시 등). 관리자 브라우저 하나만 쓸 수 있습니다.
    //
    // ▼ 아래 ADMIN_UID를 /stats/ 화면 아래쪽에 표시되는 "관리자 ID"로
    //   바꾸고 규칙을 다시 배포하세요. 그 전까지는 아무도 저장할 수 없습니다.
    //   (브라우저 저장소를 지우면 ID가 바뀌므로 다시 넣어야 합니다.)
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'ADMIN_UID';
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.status == 'active';
      // 시작 시각과 목표치는 이후 변경할 수 없습니다.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'endTime', 'milestones',
                                   'lastPress', 'lastPresser', 'winner']);
      allow delete: if false;

      // 카운터 샤드 — 동시 쓰기 분산용
      match /shards/{shard} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['c'])
                      && request.resource.data.c is int
                      && request.resource.data.c > 0
                      && request.resource.data.c <= 5000;
        allow update: if request.auth != null
                      && request.resource.data.keys().hasOnly(['c'])
                      && request.resource.data.c is int
                      && request.resource.data.c > resource.data.c
                      && request.resource.data.c - resource.data.c <= 5000;
        allow delete: if false;
      }

      // 익명 참여자별 기록 — 본인 문서만 쓸 수 있습니다.
      match /users/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.count >= resource.data.count;
        allow delete: if false;
      }
    }
  }
}
